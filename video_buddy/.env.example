# LLM provider. auto (default when unset) = llamacpp -> ollama -> grok.
# llama.cpp is the preferred local backend. Buddy starts llama-server
# against MODELS_DIR and stops that process on shutdown.
# A missing binary warns and auto falls through to Ollama.
# LLAMACPP_BIN=llama-server
# LLAMACPP_URL=http://127.0.0.1:8080
# LLAMACPP_MODEL=qwen3-vl-heretic
# Stay on one backend — pin does not hop:
# LLM_PROVIDER=llamacpp
# LLM_PROVIDER=ollama
# LLM_PANEL=local
# PANEL_JUDGE=ollama
# OLLAMA_MODEL=qwen3-vl-heretic
# OLLAMA_URL=http://127.0.0.1:11434
# Do not collide llama.cpp :8080 with Hermes 8642 or studio 8189.

# Storyboard panel: default|local | grok | grok+local|both | grok+claude | duo
# or comma list. Judge picks when 2+ members succeed.
# LLM_PANEL=default
# PANEL_JUDGE=ollama

# Identity — switch anytime (CLI `persona set` / `soul set`, Create tab, or here)
# PERSONA=ara
# SOUL=studio

# Judge / control layer
# JUDGE_STRICTNESS=0.5
# LEARNING_RATE=0.3
# COST_VRAM_THRESHOLD_GB=14.5
# RENDER_BUDGET_CAP_VRAM_MIN=80
# RENDER_BUDGET_USED_VRAM_MIN=0

# Vision evaluator (local VL judge leg) + LLM director routing
# VISION_ENABLED=1
# VISION_MODEL=qwen3-vl-heretic
# DIRECTOR_LLM=1

# Power mode: LLM proposes ComfyUI graph ops after heuristic patch
# (object_info + workflow RAG; validate-gated). Off by default.
# POWER_MODE=0
# POWER_MODE_MAX_OPS=12
# POWER_MODE_REPAIR=1

# Claude optional panel member
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5

# xAI Grok auth: xai-oauth (Hermes, default) or api_key
SPACEXAI_AUTH=xai-oauth
# XAI_API_KEY=xai-...
# SPACEXAI_MODEL=grok-4.5

# ComfyUI API
COMFYUI_URL=http://127.0.0.1:8188

# Automatic install (python -m master_agent automatic-install --yes)
# Buddy's own ComfyUI folder. Default: video_buddy/ComfyUI. Point it at a
# bigger drive if the pre-flight says there is not enough space.
# MANAGED_COMFY_ROOT=...
# COMFY_MODE=managed      # external = your own ComfyUI; automatic install refuses it
# Where Ollama keeps its models (Ollama's own setting; the pre-flight checks that drive).
# OLLAMA_MODELS=...
# HF_TOKEN is NOT needed for automatic install: the LTX 2.3 files are public.
# If you set one, it must be valid — a bad token makes even public downloads fail.

# Path overrides (defaults point at this repo)
# MODELS_DIR=...
# EXTRA_MODELS_DIRS=...   # extra volumes; pathsep or comma (e.g. D:\ComfyUI\models)
# LTX_MODELS_DIRS=...     # alias of EXTRA_MODELS_DIRS
# WORKFLOWS_DIR=...
# COMFYUI_ROOT=...

# LTX inventory (scan-local-first). doctor does not fetch.
# Standing rule: if a compatible GGUF is already on disk, Buddy loads it.
# fp8 / bf16 / EROS all-in-one are fallbacks only when that slot has no GGUF.
# Leave FORCE_LOADER unset on a 16GB+ machine that only has bf16 or EROS —
# those files still load. Do not set FORCE_LOADER=gguf unless you also want
# doctor to stop suggesting NVFP4 and bf16.
# Unset VRAM_GB: Buddy reads nvidia-smi when it can, else assumes 16.
# 12GB cards (RTX 4000 Ada / rainey1 fleet / Admeria):
# VRAM_GB=12
# FORCE_LOADER=gguf
# python -m master_agent inventory                      # paths + roles, no download
# python -m master_agent doctor --scan-only             # report only
# python -m master_agent download-models --ltx25 --use-existing
# python -m master_agent download-models --ltx25        # list confirmed-missing
# python -m master_agent download-models --ltx25 --yes  # after you agree
# HF_TOKEN=hf_...         # gated Lightricks/LTX-2.5 (only needed for download-models --ltx25 --yes)

# HeartMuLa / heartlib (optional). doctor lists slots and does not fetch.
# download-models --heartmula lists missing files; --yes only after you agree.
# Check free space first (tower F: ~28GB free on 2026-09-30; default pull ~25GB).
# HEARTMULA_MODELS_DIR=...
# HEARTMULA_MULA_REPO=HeartMuLa/HeartMuLa-oss-3B-happy-new-year
# HEARTMULA_CODEC_REPO=HeartMuLa/HeartCodec-oss-20260123
#   HeartCodec-oss (unsuffixed) returned 401. Do not set that id.
#   Pair HeartMuLa-RL-oss-3B-20260123 with HeartCodec-oss-20260123.
# HEARTMULA_TRANSCRIPTOR_REPO=HeartMuLa/HeartTranscriptor-oss
# HEARTMULA_GEN_REPO=HeartMuLa/HeartMuLaGen
# HEARTMULA_VERSION=3B
# HEARTMULA_DURATION_S=30
# HEARTMULA_DTYPE=bf16
# HEARTMULA_CODEC_DTYPE=fp32
# HEARTMULA_DEVICE=cuda
# HEARTMULA_CODEC_DEVICE=
# HEARTMULA_LAZY_LOAD=1
# HEARTMULA_LYRICS=
# HEARTMULA_TAGS=
# HEARTMULA_TRANSCRIBE=0
