{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "ltx-2.5-22b-distilled.safetensors" }
  },
  "2": {
    "class_type": "LTXVICLoRALoader",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "ltx-2.5-ic-lora.safetensors",
      "strength_model": 1.0
    },
    "_meta": { "title": "IC-LoRA" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "identity-locked video to video", "clip": ["1", 1] },
    "_meta": { "title": "Positive Prompt" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "guide.png" },
    "_meta": { "title": "Guide Frame" }
  },
  "5": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": 1280, "height": 720, "length": 145, "batch_size": 1 }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.7,
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["3", 0],
      "latent_image": ["5", 0]
    }
  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": { "frame_rate": 24, "filename_prefix": "ltx25_iclora", "format": "video/h264-mp4", "images": ["6", 0] }
  }
}
