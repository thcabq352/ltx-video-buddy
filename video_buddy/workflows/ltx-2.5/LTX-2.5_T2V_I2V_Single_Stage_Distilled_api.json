{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "ltx-2.5-22b-distilled.safetensors" },
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "cinematic hero shot", "clip": ["1", 1] },
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, watermark, text overlay", "clip": ["1", 1] },
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": 768, "height": 512, "length": 25, "batch_size": 1 },
    "_meta": { "title": "Empty LTXV Latent" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "first.png" },
    "_meta": { "title": "First Frame" }
  },
  "6": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "style.safetensors",
      "strength_model": 0.8,
      "strength_clip": 0.8
    },
    "_meta": { "title": "Standard LoRA" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["6", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    },
    "_meta": { "title": "Sampler" }
  },
  "8": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "frame_rate": 24,
      "filename_prefix": "ltx25",
      "format": "video/h264-mp4",
      "images": ["7", 0]
    },
    "_meta": { "title": "Save Video" }
  }
}
