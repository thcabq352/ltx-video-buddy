{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "ltx-2.5-22b-distilled.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "Interpolate from the first frame to the last frame. Soft camera move, matching audio.", "clip": ["1", 1] },
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "morphing, flicker, extra limbs", "clip": ["1", 1] },
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "first.png" },
    "_meta": { "title": "First Frame" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "last.png" },
    "_meta": { "title": "Last Frame" }
  },
  "6": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": 1280, "height": 720, "length": 145, "batch_size": 1 }
  },
  "7": {
    "class_type": "LTXVImgToVideo",
    "inputs": {
      "image": ["4", 0],
      "last_frame": "last.png",
      "width": 1280,
      "height": 720,
      "length": 145
    },
    "_meta": { "title": "First Last Frame" }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0]
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": { "frame_rate": 24, "filename_prefix": "ltx25_flf2v", "format": "video/h264-mp4", "images": ["8", 0] }
  }
}
